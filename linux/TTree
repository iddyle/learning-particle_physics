BRANCH: Sütun mesela Energy ya da Pt ya da Eta

ENTRY: Satur numarasıdır. Mesela ilk satır entry 0ikinci satır entry 1

EVENT: Bir satırdaki büyün bilgiler

using namespace std;
void ttree1()
{
    TFile *file = new TFile("tree.root","RECREATE");
//tree.root isminde bir ROOT dosyası oluşturuyor çünkü TTree nin de bir yere kaydedilmesi gerekiyor bu dosyaya kaydedilecek    
    TTree *tree = new TTree("tree","My First Tree");
//Bellekte boş bir TTree oluşturuyoruz. "tree" noot'un iç ismi. "my first tree" başlık
    double x;
//rastgele bir tane değişken edindik    
    tree -> Branch("x",&x);
//Tree'nin içinde x isminde bir sütun oluşturur. Tree nesnesinin Branch fonksiyonunu çağır
//& adres demektir. x in bellekteki adresi. ROOT x'in değişimini izleyeceği için adrese ihtiyacı var.
    TRandom2 *rand = new TRandom2(1);

    for(int i=0; i<100; i++)
    {
        x = rand->Gaus(5,1);
        tree->Fill();
    }

    tree->Write();
    file->Close();
}
