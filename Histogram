Konu: SetFillColor()

  h1->SetLineColor(kRed) = Çizgileri kırmızıya boyar

  h1->SetFillColor(kBlue) = histogramın içini maviye boyar
  Fill = histograma veri ekler
    h1->Fill(5); histograma 5 verisini ekle

Konu: SetLineWidth()

  h1->SetLineWidth(3); //histogramın çizgileri daha kalın olur

Konu: SetTitle()

  h1->SetTitle("My first Histogram"); //Grafiğin üst kısmındaki başlığı değiştirir

  h1->Draw();

Konu: GetXaxis()->SetTitle()    
  -- X ekseninin adını yazar

  h1-> GetXaxis()->SetTitle("Energy");
  h1->Draw();

Konu: GetYaxis()->SetTitle()
  -- Y ekseninin adını yazar. Aynı şekilde kodlanılır.

